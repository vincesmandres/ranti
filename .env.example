# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Solana (RPC must match cluster: devnet URL + NEXT_PUBLIC_SOLANA_NETWORK=devnet)
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional on-chain program (used when mint/check-in is wired to program)
# NEXT_PUBLIC_PROGRAM_ID=

# Feature flags
RANTI_ENABLE_SOLANA_COMMIT=false

# Local dev: comma-separated origins for Next.js dev (fixes blocked /_next/webpack-hmr from LAN IP)
# Example: NEXT_ALLOWED_DEV_ORIGINS=http://192.168.1.10:3000
NEXT_ALLOWED_DEV_ORIGINS=
